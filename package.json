    "test": "vitest run",
    "deploy": "npx wrangler pages deploy dist"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.12",
    "jsdom": "^24.0.0"
  }
}
