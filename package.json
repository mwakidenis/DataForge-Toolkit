{
  "name": "dataforge-toolkit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DataForge Toolkit - a production-ready client-side utility web app",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
